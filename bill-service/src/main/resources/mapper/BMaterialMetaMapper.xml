<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.billservice.demos.mapper.BMaterialMeataMapper">

    <select id="listMaterialMeta" resultType="org.example.billservice.demos.domain.BMaterialMeata">
        select * from b_materialmeta
    </select>

    <insert id="insertMaterialMeta" parameterType="org.example.billservice.demos.domain.BMaterialMeata">
        insert into b_materialmeta (code,label) values
            <foreach collection="list" item="item" separator=",">
                (#{item.code},#{item.label})
            </foreach>
    </insert>
</mapper>