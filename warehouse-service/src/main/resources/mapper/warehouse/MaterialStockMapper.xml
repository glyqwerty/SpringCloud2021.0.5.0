<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.warehouseservice.mapper.BMaterialStockMapper">


    <insert id="createMaterialStock" parameterType="org.example.warehouseservice.domain.BMaterialStock">
        insert into b_materialstock(positionCode,materialCode,warehouseCode,qty,usableQty,version)
        values
            (#{positionCode},#{materialCode},#{warehouseCode},#{qty},#{usableQty},1)
    </insert>

    <update id="updateBMaterialStock" parameterType="org.example.warehouseservice.domain.BMaterialStock">
        update b_materialstock set qty=#{qty},usableQty = #{usableQty},version=#{version}+1 where id = #{id} and version=#{version}
    </update>

    <select id="getBMaterialStockByMaterialCodeAndPositionCode" resultType="org.example.warehouseservice.domain.BMaterialStock">
        select * from b_materialstock where materialCode =#{materialCode} and positionCode =#{positionCode} limit 1
    </select>

    <update id="updateBillStatusByBillCode">
        update b_inbillinfo set status = #{status}
        where billCode =#{billCode}
          and status =#{oldStatus}
    </update>
</mapper>